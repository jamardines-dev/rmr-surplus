<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.vehicle.sales.presentation.EmployeeSalesController"
            prefHeight="720"
            prefWidth="1120"
            styleClass="screen">
    <left>
        <fx:include source="../common/sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets bottom="28" left="28" right="28" top="28"/>
            </padding>

            <VBox spacing="4" styleClass="header">
                <Label text="My Sales Today" styleClass="title"/>
                <Label text="Review today’s sales. Double-click a sold product to view details or undo it." styleClass="subtitle"/>
            </VBox>

            <HBox styleClass="toolbar">
                <Label fx:id="summaryLabel" text="Transactions today: 0 | Items sold: 0 | Total sales: ₱0.00" styleClass="cart-total"/>
                <Button onAction="#refreshSales" styleClass="secondary" text="Refresh"/>
            </HBox>

            <VBox spacing="10" styleClass="section" VBox.vgrow="ALWAYS">
                <TableView fx:id="mySalesTable" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="saleTimeColumn" prefWidth="90" text="Time"/>
                        <TableColumn fx:id="saleProductColumn" prefWidth="250" text="Product"/>
                        <TableColumn fx:id="saleBrandColumn" prefWidth="140" text="Brand"/>
                        <TableColumn fx:id="saleVehicleTypeColumn" prefWidth="150" text="Vehicle Type"/>
                        <TableColumn fx:id="saleModelCodeColumn" prefWidth="120" text="Model Code"/>
                        <TableColumn fx:id="saleQuantityColumn" prefWidth="80" text="Qty"/>
                        <TableColumn fx:id="salePriceColumn" prefWidth="120" text="Price"/>
                        <TableColumn fx:id="saleTotalColumn" prefWidth="130" text="Total"/>
                    </columns>
                </TableView>
            </VBox>

            <Label fx:id="messageLabel" minHeight="24" wrapText="true" styleClass="message"/>
        </VBox>
    </center>
</BorderPane>
