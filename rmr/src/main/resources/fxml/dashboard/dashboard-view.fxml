<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.vehicle.dashboard.presentation.DashboardController"
            prefHeight="720"
            prefWidth="1120"
            styleClass="screen">
    <left>
        <fx:include source="../common/sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets bottom="28" left="28" right="28" top="28"/>
            </padding>

            <VBox spacing="4" styleClass="header">
                <Label text="Admin Dashboard" styleClass="title"/>
                <Label text="Daily sales, employee activity, and inventory alerts." styleClass="subtitle"/>
            </VBox>

            <GridPane hgap="14" vgap="14">
                <VBox minWidth="170" spacing="6" styleClass="summary-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Sales Today" styleClass="summary-label"/>
                    <Label fx:id="todaySalesLabel" text="₱0.00" styleClass="summary-value"/>
                </VBox>
                <VBox minWidth="170" spacing="6" styleClass="summary-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Items Sold" styleClass="summary-label"/>
                    <Label fx:id="itemsSoldTodayLabel" text="0" styleClass="summary-value"/>
                </VBox>
                <VBox minWidth="170" spacing="6" styleClass="summary-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Transactions" styleClass="summary-label"/>
                    <Label fx:id="transactionsTodayLabel" text="0" styleClass="summary-value"/>
                </VBox>
                <VBox minWidth="170" spacing="6" styleClass="summary-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <Label text="Active Products" styleClass="summary-label"/>
                    <Label fx:id="productCountLabel" text="0" styleClass="summary-value"/>
                </VBox>
                <VBox minWidth="170" spacing="6" styleClass="summary-card" GridPane.columnIndex="4" GridPane.rowIndex="0">
                    <Label text="Out of Stock" styleClass="summary-label"/>
                    <Label fx:id="outOfStockLabel" text="0" styleClass="summary-value"/>
                </VBox>
            </GridPane>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="10" styleClass="section" HBox.hgrow="ALWAYS">
                    <Label text="Recent Employee Sales" styleClass="section-title"/>
                    <TableView fx:id="recentSalesTable" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="sellerColumn" prefWidth="140" text="Employee"/>
                            <TableColumn fx:id="activityColumn" prefWidth="360" text="Activity"/>
                            <TableColumn fx:id="saleTotalColumn" prefWidth="120" text="Total"/>
                            <TableColumn fx:id="soldAtColumn" prefWidth="170" text="Date and Time"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10" styleClass="section" prefWidth="440" HBox.hgrow="ALWAYS">
                    <Label text="Sales Summary Per Employee" styleClass="section-title"/>
                    <TableView fx:id="employeeSummaryTable" maxHeight="Infinity" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="employeeColumn" prefWidth="135" text="Employee"/>
                            <TableColumn fx:id="employeeTransactionsColumn" prefWidth="105" text="Transactions"/>
                            <TableColumn fx:id="employeeItemsColumn" prefWidth="85" text="Items"/>
                            <TableColumn fx:id="employeeSalesColumn" prefWidth="115" text="Sales"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
