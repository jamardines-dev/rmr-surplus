<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.vehicle.product.presentation.ProductListController"
            prefHeight="720"
            prefWidth="1120"
            styleClass="screen">
    <left>
        <fx:include source="../common/sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets bottom="28" left="28" right="28" top="28"/>
            </padding>
            <VBox spacing="4" styleClass="header">
                <Label text="Products" styleClass="title"/>
                <Label text="Manage product details and pricing." styleClass="subtitle"/>
            </VBox>

            <HBox spacing="10" styleClass="section">
                <TextField fx:id="searchField" onAction="#searchProduct" prefWidth="420" promptText="Search product, brand, vehicle type, or model code"/>
                <Button onAction="#searchProduct" text="Search Product"/>
                <Button onAction="#clearSearch" styleClass="secondary" text="Clear Search"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="10" styleClass="section" HBox.hgrow="ALWAYS">
                    <Label text="Product List" styleClass="section-title"/>
                    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="60" text="ID"/>
                            <TableColumn fx:id="productNameColumn" prefWidth="260" text="Product"/>
                            <TableColumn fx:id="brandColumn" prefWidth="150" text="Brand"/>
                            <TableColumn fx:id="vehicleTypeColumn" prefWidth="160" text="Vehicle Type"/>
                            <TableColumn fx:id="modelCodeColumn" prefWidth="130" text="Model Code"/>
                            <TableColumn fx:id="stockColumn" prefWidth="90" text="Stock"/>
                            <TableColumn fx:id="priceColumn" prefWidth="130" text="Default Price"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox minWidth="390" prefWidth="430" spacing="14" styleClass="section">
                    <Label text="Product Details" styleClass="section-title"/>

                    <VBox spacing="6">
                        <Label text="Product" styleClass="field-label"/>
                        <TextField fx:id="productNameField" maxWidth="Infinity" promptText="Starter solenoid"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Brand" styleClass="field-label"/>
                        <TextField fx:id="brandField" maxWidth="Infinity" promptText="Mitsubishi"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Vehicle Type" styleClass="field-label"/>
                        <TextField fx:id="vehicleTypeField" maxWidth="Infinity" promptText="10 Wheeler"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Model Code" styleClass="field-label"/>
                        <TextField fx:id="modelCodeField" maxWidth="Infinity" promptText="8M20"/>
                    </VBox>
                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Stock Quantity" styleClass="field-label"/>
                            <TextField fx:id="stockQuantityField" maxWidth="Infinity" promptText="10"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Default Price" styleClass="field-label"/>
                            <TextField fx:id="priceField" maxWidth="Infinity" promptText="1200.00"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <Button maxWidth="Infinity" onAction="#createProduct" text="Create" HBox.hgrow="ALWAYS"/>
                        <Button maxWidth="Infinity" onAction="#updateProduct" text="Update" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button maxWidth="Infinity" onAction="#clearForm" styleClass="secondary" text="Clear" HBox.hgrow="ALWAYS"/>
                        <Button maxWidth="Infinity" onAction="#deleteProduct" styleClass="danger" text="Delete" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </HBox>

            <Label fx:id="messageLabel" minHeight="24" styleClass="message"/>
        </VBox>
    </center>
</BorderPane>
