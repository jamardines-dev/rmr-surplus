<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.vehicle.dashboard.presentation.DashboardController"
            prefHeight="720"
            prefWidth="1120"
            styleClass="screen">
    <left>
        <fx:include source="../common/sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets bottom="28" left="28" right="28" top="28"/>
            </padding>

            <VBox spacing="4" styleClass="header">
                <Label text="Dashboard" styleClass="title"/>
                <Label text="Overview of inventory, stock, and sales activity." styleClass="subtitle"/>
            </VBox>

            <GridPane hgap="14" vgap="14">
                <VBox minWidth="190" spacing="6" styleClass="summary-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Products" styleClass="summary-label"/>
                    <Label fx:id="productCountLabel" text="0" styleClass="summary-value"/>
                </VBox>
                <VBox minWidth="190" spacing="6" styleClass="summary-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Total Stock" styleClass="summary-label"/>
                    <Label fx:id="totalStockLabel" text="0" styleClass="summary-value"/>
                </VBox>
                <VBox minWidth="190" spacing="6" styleClass="summary-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Today's Sales" styleClass="summary-label"/>
                    <Label fx:id="todaySalesLabel" text="0.00" styleClass="summary-value"/>
                </VBox>
            </GridPane>

            <HBox spacing="16">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Inventory Details" styleClass="section-title"/>
                    <TableView fx:id="inventoryTable" prefHeight="360" prefWidth="500">
                        <columns>
                            <TableColumn fx:id="productNameColumn" prefWidth="210" text="Product"/>
                            <TableColumn fx:id="brandColumn" prefWidth="150" text="Part Brand"/>
                            <TableColumn fx:id="stockColumn" prefWidth="90" text="Stock"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Recent Sales" styleClass="section-title"/>
                    <TableView fx:id="recentSalesTable" prefHeight="360" prefWidth="360">
                        <columns>
                            <TableColumn fx:id="saleIdColumn" prefWidth="70" text="ID"/>
                            <TableColumn fx:id="sellerColumn" prefWidth="150" text="Seller"/>
                            <TableColumn fx:id="saleTotalColumn" prefWidth="120" text="Total"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
