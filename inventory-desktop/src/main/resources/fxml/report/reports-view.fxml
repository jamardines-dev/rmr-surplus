<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventory.vehicle.report.presentation.ReportController"
            prefHeight="720"
            prefWidth="1120"
            styleClass="screen">
    <left>
        <fx:include source="../common/sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets bottom="28" left="28" right="28" top="28"/>
            </padding>
            <VBox spacing="4" styleClass="header">
                <Label text="Reports" styleClass="title"/>
                <Label text="Inventory overview and daily sales total." styleClass="subtitle"/>
            </VBox>
            <HBox styleClass="toolbar">
                <DatePicker fx:id="salesDatePicker" prefWidth="180"/>
                <Button onAction="#refreshReports" text="Refresh"/>
                <Label fx:id="totalSalesLabel" styleClass="subtitle"/>
            </HBox>
            <TableView fx:id="productTable" prefHeight="460">
                <columns>
                    <TableColumn fx:id="productNameColumn" prefWidth="280" text="Product"/>
                    <TableColumn fx:id="brandColumn" prefWidth="190" text="Part Brand"/>
                    <TableColumn fx:id="stockColumn" prefWidth="130" text="Stock"/>
                    <TableColumn fx:id="priceColumn" prefWidth="150" text="Unit Price"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
